{
  "testDirs": [
    "tests",
    "scripts/build-works.test.mjs",
    "i18n/check.mjs"
  ],
  "harnessPaths": [
    ".claude/hooks",
    ".claude/settings.json",
    ".github/workflows",
    ".github/scripts",
    "playwright.config.cjs",
    "tests/server.cjs"
  ],
  "testCommand": "node --test && node i18n/check.mjs && npx playwright test",
  "testTimeoutSec": 840,
  "setupCheck": [
    "node_modules/@playwright/test"
  ],
  "setupCommand": "npm i --no-save @playwright/test@1.56.1",
  "stopLossAfter": 3,
  "tailLines": 60,
  "site": {
    "pages": [
      "index.html",
      "devlog/index.html",
      "privacy/index.html",
      "weekly/index.html",
      "weekly/2026-11-10/index.html",
      "weekly/2026-11-03/index.html"
    ],
    "mountedRoutes": ["/relay-ai-guess/"],
    "inappLock": "none",
    "settleMs": 1500
  }
}
